# Server-only. Copy to .env (never commit .env). Placeholders only.
NODE_ENV=development
PORT=4000
CLIENT_URL=http://localhost:5173
# Neon: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/shipflow
# At least 32 random characters, e.g. `openssl rand -hex 32`
JWT_SECRET=
# Access tokens are short-lived; a rotating httpOnly refresh cookie keeps people signed in (30 days)
JWT_EXPIRES_IN=15m
# Used only by `npm run seed` to create the first admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional carrier credentials (providers report "not configured" without them)
DHL_API_KEY=
FEDEX_API_KEY=
UPS_API_KEY=
USPS_API_KEY=
